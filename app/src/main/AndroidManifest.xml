<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Updates itself from the family's GitHub releases (shared/java/com/family/update) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <permission android:name="com.family.permission.UPDATE_NOW" android:protectionLevel="signature" />
    <uses-permission android:name="com.family.permission.UPDATE_NOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- reads the weekly screen time from Kids Corner (same signing key) -->
    <permission android:name="com.family.kids.permission.READ_STATS" android:protectionLevel="signature" />
    <uses-permission android:name="com.family.kids.permission.READ_STATS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- lets Parent settings switch the screensaver; granted once over ADB by Update TV -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Family TV Home"
        android:icon="@mipmap/icon"
        android:banner="@mipmap/banner"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Remote buttons: Prime Video opens Stremio, Apps opens Kodi, YouTube asks for the PIN first. Switched on by Update TV. -->
        <service
            android:name=".RemoteKeys"
            android:exported="true"
            android:label="Family TV remote buttons"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/remote_keys" />
        </service>
        <service
            android:name="com.family.update.UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name="com.family.update.UpdateReceiver"
            android:exported="true"
            android:permission="com.family.permission.UPDATE_NOW">
            <intent-filter>
                <action android:name="com.family.update.NOW" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
